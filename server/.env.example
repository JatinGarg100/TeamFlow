# Server Environment Variables (Template)
# Copy this file to .env and replace the placeholders with your actual values

# The port where the Express server will run
PORT=5000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/teamflow?retryWrites=true&w=majority

# Frontend URL allowed for Cross-Origin Resource Sharing (CORS) and email invitation links
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Email Notification Service (Resend)
# Priority provider when RESEND_API_KEY is configured
RESEND_API_KEY=
RESEND_FROM=TeamFlow <onboarding@resend.dev>
EMAIL_FROM=TeamFlow <onboarding@resend.dev>

# Email Notification Service (SMTP Fallback)
# Optional in local development — if omitted, emails are logged safely to the console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=TeamFlow <notifications@yourdomain.com>

# Google OAuth 2.0 (Google Identity Services)
# Required for Google Sign-In & Registration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
