# Server Environment Variables (Template)
# Copy this file to .env and replace the placeholders with your actual values

# The port where the Express server will run
PORT=5000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/teamflow?retryWrites=true&w=majority

# Frontend URL allowed for Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:5173

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=teamflow_super_secret_jwt_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Email Notification Service (SMTP)
# Optional in local development — if omitted, emails are logged safely to the console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=TeamFlow <notifications@yourdomain.com>
