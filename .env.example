# Root Environment Variables Template for Docker Compose
# Copy this file to .env before running `docker compose up`

# Port mappings for host machine
CLIENT_PORT=5173
SERVER_PORT=5000

# Backend environment configuration
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Secret key used to sign and verify JSON Web Tokens (JWT)
# IMPORTANT: Generate a strong, random 64-character secret in production!
JWT_SECRET=replace_this_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# MongoDB connection string within Docker internal network
MONGODB_URI=mongodb://mongodb:27017/teamflow
